    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus"
  },
  "dependencies": {
    "chromecast-api": "^0.4.2",
    "node-ssdp": "^4.0.1",
    "playwright": "^1.64.1",
    "socks-proxy-agent": "^10.1.0"
  }
}
