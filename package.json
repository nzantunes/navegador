{
  "name": "navegador",
  "version": "1.0.0",
  "description": "",
  "main": "main/main.js",
  "scripts": {
    "start": "electron --no-sandbox --no-zygote .",
    "test": "node bin/validate-code.js && node --test tests/*.test.js",
    "test:unit": "node --test tests/*.test.js",
    "agent:watch": "node bin/antigravity-code-auditor.js --watch",
    "agent:audit": "node bin/antigravity-code-auditor.js",
    "build:rust": "cd papaleguas-core && cargo build --release && cp target/release/libpapaleguas_core.so papaleguas_core.node",
    "persistent": "bash ./start-persistent.sh start",
    "supervisor:status": "bash ./start-persistent.sh status",
    "tunnel:cloudflare": "bash ./start_tunnel.sh"
  },
